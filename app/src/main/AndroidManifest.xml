<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
    </queries>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application android:name=".FocusApplication" android:label="Floating Focus" android:icon="@drawable/ic_focus"
        android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true" android:theme="@style/Theme.FloatingFocus">
        <activity android:name=".AutoTriggerActivity" android:exported="false" />
        <activity android:name=".HistoryActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".PresetShortcutActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity="${applicationId}.presetshortcut"
            android:excludeFromRecents="true" />
        <receiver android:name=".PresetPinnedReceiver" android:exported="false" />
        <activity android:name=".WidgetStartActivity" android:exported="false" android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.widget" android:excludeFromRecents="true" />
        <receiver android:name=".TimerWidgetProvider" android:label="@string/widget_timer_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timer_info" />
        </receiver>
        <receiver android:name=".PresetsWidgetProvider" android:label="@string/widget_presets_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_presets_info" />
        </receiver>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".FloatingService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started floating countdown or stopwatch with local session records with an ongoing stop notification. The user may explicitly open a selected app after starting the timer. No app usage monitoring, accessibility or automatic restart." />
        </service>
    </application>
</manifest>
