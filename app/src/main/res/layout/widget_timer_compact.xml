<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_surface" android:padding="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="6dp">
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_countdown" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <Chronometer android:id="@+id/widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/widget_ink" android:textSize="22sp" android:fontFamily="monospace" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_preview_time" android:textColor="@color/widget_ink" android:textSize="22sp" android:fontFamily="monospace" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_primary" android:layout_width="48dp" android:layout_height="44dp"
        android:text="@string/widget_start" android:gravity="center" android:textColor="@color/widget_on_primary" android:textSize="12sp"
        android:background="@drawable/widget_primary" android:maxLines="1" android:clickable="true" />
</LinearLayout>
